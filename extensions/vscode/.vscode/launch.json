{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run extension on target/",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/../../target"],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "build"
    },
    {
      "name": "Run extension on a folder…",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${input:folder}"],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "build"
    }
  ],
  "inputs": [
    {
      "id": "folder",
      "type": "promptString",
      "description": "Folder to open (one holding a mockup project space)"
    }
  ]
}
